# ─── Server ───────────────────────────────────────────────────────────────────
# Port is usually set automatically by the hosting platform. Only set manually for local dev.
PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_min_64_chars
JWT_EXPIRES_IN=30d

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyBD2Bbyz3ZVz4Q5p5h_m-tKWFem-OdvQRI
GEMINI_MODEL=gemini-2.5-flash

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your deployed frontend URL. Comma-separate multiple origins.
# Example: https://myapp.vercel.app,https://myapp.com
CLIENT_URL=http://localhost:5173
